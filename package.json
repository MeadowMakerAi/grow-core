{
  "name": "grow-core",
  "version": "0.2.0",
  "description": "Framework-agnostic cultivation science core (DLI, VPD, psychrometrics, pathogen pressure, fixtures, heat, yield) — the shared source of truth for greenhouse-cannabis-model and ag-twin.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models/*": {
      "types": "./dist/models/*.d.ts",
      "import": "./dist/models/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js"
    },
    "./data/*": {
      "types": "./dist/data/*.d.ts",
      "import": "./dist/data/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CITATIONS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "vitest": "^4.1.0"
  }
}
